# Wirety Server Configuration

# Server Configuration
HTTP_PORT=8080

# Authentication Configuration
# Set to "true" to enable OIDC authentication, "false" for open mode (admin permissions for all)
AUTH_ENABLED=false

# OIDC Provider Configuration (required when AUTH_ENABLED=true)
# Example for Keycloak:
AUTH_ISSUER_URL=https://keycloak.example.com/realms/wirety
AUTH_CLIENT_ID=wirety-server

# Optional: JWKS cache TTL in seconds (default: 3600)
AUTH_JWKS_CACHE_TTL=3600

# Optional: OAuth scopes requested at login.
# Default: "openid profile email offline_access" (offline_access is omitted
# automatically for Google and Slack, which reject it). offline_access is what
# makes the provider issue a refresh token — without one, sessions end as soon
# as the first id_token expires.
# AUTH_SCOPES="openid profile email offline_access"

# Optional: extra query params appended to the authorization URL.
# Google needs this to issue a refresh token:
# AUTH_AUTHORIZATION_EXTRA_PARAMS="access_type=offline&prompt=consent"

# Development Mode Example (No Authentication)
# AUTH_ENABLED=false
# HTTP_PORT=8080

# Production Mode Example (With Keycloak)
# AUTH_ENABLED=true
# AUTH_ISSUER_URL=https://keycloak.example.com/realms/wirety
# AUTH_CLIENT_ID=wirety-server
# HTTP_PORT=8080
