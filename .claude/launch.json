{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Postgres (Docker)",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "docker start -a wirety-postgres 2>/dev/null || docker run --name wirety-postgres -v wirety-postgres-data:/var/lib/postgresql/data -e POSTGRES_USER=wirety -e POSTGRES_PASSWORD=wirety -e POSTGRES_DB=wirety -p 5432:5432 postgres:16"
      ],
      "port": 5432
    },
    {
      "name": "Frontend (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "front",
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "Frontend (production build)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "cwd": "front",
      "port": 4173
    },
    {
      "name": "Server (Go)",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/main.go"
      ],
      "cwd": "server",
      "port": 8080,
      "env": {
        "DB_ENABLED": "true",
        "DB_DSN": "postgres://wirety:wirety@localhost:5432/wirety?sslmode=disable",
        "KO_DATA_PATH": "cmd/kodata"
      },
      "dependsOn": [
        "Postgres (Docker)"
      ]
    },
    {
      "name": "Docs (Docusaurus)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "cwd": "doc",
      "port": 3000
    },
    {
      "name": "Postgres (throwaway, dev)",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "docker rm -f wirety-pg-dev >/dev/null 2>&1; docker run --rm --name wirety-pg-dev -e POSTGRES_USER=wirety -e POSTGRES_PASSWORD=wirety -e POSTGRES_DB=wirety -p 55432:5432 postgres:16"
      ],
      "port": 55432
    },
    {
      "name": "Server (dev, throwaway DB)",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/main.go"
      ],
      "cwd": "server",
      "port": 18080,
      "env": {
        "HTTP_PORT": "18080",
        "DB_ENABLED": "true",
        "DB_DSN": "postgres://wirety:wirety@localhost:55432/wirety?sslmode=disable",
        "AUTH_ENABLED": "false",
        "AUTH_PASSWORD": "wirety-dev",
        "KO_DATA_PATH": "cmd/kodata"
      },
      "dependsOn": [
        "Postgres (throwaway, dev)"
      ]
    },
    {
      "name": "Frontend (Vite \u2192 dev server)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "cwd": "front",
      "port": 5174,
      "env": {
        "WIRETY_API_URL": "http://localhost:18080"
      },
      "dependsOn": [
        "Server (dev, throwaway DB)"
      ]
    }
  ]
}
